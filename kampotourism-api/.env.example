# Template only. Copy to .env (git-ignored) for local development and fill in real values.
# In production set these in the hosting dashboard (Render > Environment), never in a file.

# --- Database ---------------------------------------------------------------------------
# Local:  jdbc:postgresql://localhost:5432/kampotourism
# Neon:   jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_URL=jdbc:postgresql://localhost:5432/kampotourism
DB_USER=postgres
DB_PASSWORD=change-me

# --- Security ---------------------------------------------------------------------------
# At least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-bytes
# First ADMIN, created only while the admin table is empty. Password: 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-12-chars-minimum

# --- Web --------------------------------------------------------------------------------
# Production only (comma-separated exact origins of the public site and admin CMS)
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com

# --- Media ------------------------------------------------------------------------------
# local (dev; files in MEDIA_DIR) or cloudinary (production)
MEDIA_STORAGE=local
MEDIA_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kampotourism
